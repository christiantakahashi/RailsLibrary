<h1>Novo Livro</h1>

<% if @book.errors.any? %>
  <div>
    <h2> <%= @book.errors.count %> erro(s) impediram o cadastro:</h2>
    <ul>
      <% @book.errors.full_messages.each do |message| %>
        <li> <%= message %> </li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @book, url: "/books" do |form| %>
  <div>
    <%= form.label :title, "Título" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :author, "Autor" %>
    <%= form.text_field :author %>
  </div>

  <div>
    <%= form.label :year, "Ano de publicação" %>
    <%= form.number_field :year %>
  </div>

  <div>
    <%= form.label :read, "Já li" %>
    <%= form.checkbox :read %>
  </div>

  <%= form.submit "Salvar"%>
<% end %>

<%= link_to "Voltar para a lista", "/books" %>
