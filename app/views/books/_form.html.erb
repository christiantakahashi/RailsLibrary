
<% if book.errors.any? %>
  <div>
    <h2> <%= book.errors.count %> erro(s) impediram o cadastro:</h2>
    <ul>
      <% book.errors.full_messages.each do |message| %>
        <li> <%= message %> </li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: book do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :author_id %>
    <%= form.collection_select :author_id, Author.all, :id, :name, prompt: "Escolha um autor" %>
  </div>

  <div>
    <%= form.label :year %>
    <%= form.number_field :year %>
  </div>

  <div>
    <%= form.label :read %>
    <%= form.checkbox :read %>
  </div>

  <%= form.submit "Salvar"%>
<% end %>


