<h1><%= @book.title %></h1>

<p><strong>Autor:</strong> <%= @book.author %></p>
<p><strong>Ano:</strong> <%= @book.year%></p>
<p><strong>Lido:</strong> <%= @book.read ? "Sim" : "Não"%></p>

<%= link_to "Voltar para a lista", books_path %>
<%= link_to "Editar livro", edit_book_path %>
<%= button_to "Deletar livro", book_path, method: :delete, form: { data: { turbo_confirm: "Tem certeza que deseja apagar este livro?" } } %>
